# 日付も作者も消して、コミットメッセージ(commit-title)だけに絞る
set main-view = commit-title

# blame ビューのファイル名列を消す（リネーム履歴があっても右を広く保つ）
set blame-view = id:yes,author:full,date:default,file-name:no,line-number:yes,text

# 起動時から垂直分割（Vertical）にする
set vertical-split = yes

# 右側(diff)を広く保つための幅設定
set split-view-width = 80%

# 【これで確定】タイトルとフッターの視認性向上設定

# 1. 一番上のバー（タイトル）：背景を青、文字を白（太字）にしてはっきりさせます
color title-focus   255  blue    bold
color title-blur    255  234

# 2. 下のバー（フッター）：背景を濃いグレー（234）にし、文字を白抜きにします
color status        255  234

# 3. 選択行（カーソル）：どこを選んでいるか分かりやすくします
color cursor        255  24     bold

# git-peek 連携：選択中のコミットを emacsclient 経由で git-peek に渡す
bind generic E !sh -c "emacsclient --eval '(git-peek-from-hash \"%(commit)\")';xdotool getactivewindow windowminimize"

# commit-msg 連携（> はコマンド終了後に tig を再オープンする）
bind status C >/home/minoru/src/github.com/minorugh/dotfiles/bin/tig-git.sh commit "%(file)"
bind stage  C >/home/minoru/src/github.com/minorugh/dotfiles/bin/tig-git.sh commit "%(file)"
bind status A >/home/minoru/src/github.com/minorugh/dotfiles/bin/tig-git.sh all
bind stage  A >/home/minoru/src/github.com/minorugh/dotfiles/bin/tig-git.sh all
bind status P >/home/minoru/src/github.com/minorugh/dotfiles/bin/tig-git.sh push
bind stage  P >/home/minoru/src/github.com/minorugh/dotfiles/bin/tig-git.sh push
